---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { getCategorySlug } from "../../lib/notes";

export async function getStaticPaths() {
	const notes = await getCollection("notes");

	return notes.map((note) => ({
		params: { slug: note.id },
		props: { note },
	}));
}

const { note } = Astro.props;
const { Content } = await render(note);
const categoryUrl = `/notes/category/${getCategorySlug(note.data.category)}/`;
---

<BaseLayout title={`${note.data.title} | Hsiun Blog`}>
	<article class="mx-auto min-h-screen max-w-4xl px-5 py-20">
		<a href="/notes" class="text-sm font-medium text-zinc-500 hover:text-zinc-950">
			← 回筆記列表
		</a>

		<header class="mt-8">
			<div class="flex flex-wrap items-center gap-2 text-sm text-zinc-500">
				<span>建立 {note.data.pubDate.toLocaleDateString("zh-TW")}</span>
				{
					note.data.updatedDate && (
						<>
							<span>·</span>
							<span>更新 {note.data.updatedDate.toLocaleDateString("zh-TW")}</span>
						</>
					)
				}
				<span>·</span>
				<a href={categoryUrl} class="hover:text-zinc-950">{note.data.category}</a>
			</div>
			<h1 class="mt-3 text-4xl font-bold tracking-tight text-zinc-950">
				{note.data.title}
			</h1>
			<p class="mt-4 text-lg leading-8 text-zinc-600">
				{note.data.description}
			</p>
		</header>

		<div class="note-content mt-10 text-base leading-8 text-zinc-700">
			<Content />
		</div>
	</article>
</BaseLayout>
