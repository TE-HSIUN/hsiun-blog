---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { getCategorySlug } from "../../lib/notes";
import { withBase } from "../../lib/urls";

export async function getStaticPaths() {
	const notes = await getCollection("notes");

	return notes.map((note) => ({
		params: { slug: note.id },
		props: { note },
	}));
}

const { note } = Astro.props;
const { Content } = await render(note);
const categoryUrl = withBase(`notes/category/${getCategorySlug(note.data.category)}/`);
---

<BaseLayout title={`${note.data.title} | Hsiun Blog`}>
	<article class="mx-auto min-h-screen max-w-5xl px-5 py-20 sm:py-24">
		<a href={withBase("notes/")} class="inline-flex rounded-full border border-zinc-200 bg-white/70 px-4 py-2 text-sm font-medium text-zinc-600 backdrop-blur transition hover:-translate-y-0.5 hover:border-zinc-300 hover:text-zinc-950 dark:border-zinc-700 dark:bg-zinc-900/70 dark:text-zinc-300 dark:hover:text-zinc-50">
			← 回筆記列表
		</a>

		<header class="surface-card mt-8 rounded-3xl p-6 sm:p-10">
			<div class="flex flex-wrap items-center gap-2 text-sm text-zinc-500">
				<span>建立 {note.data.pubDate.toLocaleDateString("zh-TW")}</span>
				{
					note.data.updatedDate && (
						<>
							<span>·</span>
							<span>更新 {note.data.updatedDate.toLocaleDateString("zh-TW")}</span>
						</>
					)
				}
				<span>·</span>
				<a href={categoryUrl} class="hover:text-zinc-950 dark:hover:text-zinc-50">{note.data.category}</a>
			</div>
			<h1 class="mt-4 max-w-3xl text-4xl font-black tracking-tight text-zinc-950 dark:text-zinc-50 sm:text-5xl">
				{note.data.title}
			</h1>
			<p class="mt-4 max-w-2xl text-base leading-8 text-zinc-600 dark:text-zinc-300">
				{note.data.description}
			</p>
			{
				note.data.image && (
					<img
						src={note.data.image}
						alt={note.data.imageAlt ?? note.data.title}
						class="mt-8 aspect-[16/9] w-full rounded-2xl object-cover shadow-2xl shadow-zinc-950/15 dark:shadow-black/35"
					/>
				)
			}
		</header>

		<div class="note-content mx-auto mt-12 max-w-3xl text-base leading-8 text-zinc-700 dark:text-zinc-300">
			<Content />
		</div>

	</article>
</BaseLayout>
