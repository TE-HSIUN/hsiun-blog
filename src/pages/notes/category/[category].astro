---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import {
	getCategorySlug,
	getNoteCategories,
	getNoteDisplayDate,
	getNoteDisplayDateLabel,
	sortNotesByDate,
} from "../../../lib/notes";

export async function getStaticPaths() {
	const notes = await getCollection("notes");
	const categories = getNoteCategories(notes);

	return categories.map((category) => ({
		params: { category: category.slug },
		props: { category },
	}));
}

const { category } = Astro.props;
const allNotes = await getCollection("notes");
const notes = sortNotesByDate(
	allNotes.filter((note) => getCategorySlug(note.data.category) === category.slug),
);
const categories = getNoteCategories(allNotes);
---

<BaseLayout title={`${category.name} 筆記 | Hsiun Blog`}>
	<section class="mx-auto min-h-screen max-w-4xl px-5 py-20">
		<div class="mx-auto max-w-4xl">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-zinc-500">
				Notes
			</p>
			<h1 class="mt-4 text-4xl font-bold tracking-tight text-zinc-950">
				{category.name}
			</h1>

			<nav class="mt-8 flex flex-wrap gap-2" aria-label="筆記分類">
				<a
					href="/notes"
					class="rounded-full border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-950"
				>
					全部
				</a>
				{
					categories.map((item) => (
						<a
							href={`/notes/category/${item.slug}/`}
							class={
								item.slug === category.slug
									? "rounded-full bg-zinc-950 px-4 py-2 text-sm font-medium text-white"
									: "rounded-full border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-950"
							}
						>
							{item.name}
						</a>
					))
				}
			</nav>

			<div class="mt-10 space-y-4">
				{
					notes.map((note) => (
						<a
							href={`/notes/${note.id}/`}
							class="block rounded-xl border border-zinc-200 bg-white p-5 transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-zinc-950/10"
						>
							<p class="text-sm text-zinc-500">
								{getNoteDisplayDateLabel(note)}{" "}
								{getNoteDisplayDate(note).toLocaleDateString("zh-TW")}
							</p>
							<h2 class="mt-2 text-xl font-semibold text-zinc-950">
								{note.data.title}
							</h2>
							<p class="mt-2 text-sm leading-6 text-zinc-600">
								{note.data.description}
							</p>
						</a>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
