---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import {
	getCategorySlug,
	getNoteCategories,
	getNoteDisplayDate,
	getNoteDisplayDateLabel,
	sortNotesByDate,
} from "../../../lib/notes";
import { withBase } from "../../../lib/urls";

export async function getStaticPaths() {
	const notes = await getCollection("notes");
	const categories = getNoteCategories(notes);

	return categories.map((category) => ({
		params: { category: category.slug },
		props: { category },
	}));
}

const { category } = Astro.props;
const allNotes = await getCollection("notes");
const notes = sortNotesByDate(
	allNotes.filter((note) => getCategorySlug(note.data.category) === category.slug),
);
const categories = getNoteCategories(allNotes);
---

<BaseLayout title={`${category.name} 文章 | Hsiun Blog`}>
	<section class="mx-auto min-h-screen max-w-5xl px-5 py-20 sm:py-24">
		<div class="mx-auto max-w-4xl">
			<div class="surface-card rounded-3xl p-6 sm:p-8">
				<p class="eyebrow">Articles</p>
				<h1 class="mt-4 text-4xl font-black tracking-tight text-zinc-950 dark:text-zinc-50 sm:text-5xl">
					{category.name}
				</h1>
				<p class="mt-4 max-w-2xl text-base leading-7 text-zinc-600 dark:text-zinc-300">
					瀏覽這個主題下的文章，從軟體開發的觀念、實作到問題排查，逐步建立完整脈絡。
				</p>
			</div>

			<nav class="mt-8 flex flex-wrap gap-2" aria-label="文章分類">
				<a
					href={withBase("notes/")}
					class="pill-link rounded-full px-4 py-2 text-sm font-medium transition"
				>
					All Articles
				</a>
				{
					categories.map((item) => (
						<a
							href={withBase(`notes/category/${item.slug}/`)}
							class={
								item.slug === category.slug
									? "pill-active rounded-full px-4 py-2 text-sm font-semibold"
									: "pill-link rounded-full px-4 py-2 text-sm font-medium transition"
							}
						>
							{item.name}
						</a>
					))
				}
			</nav>

			<div class="mt-10 space-y-4">
				{
					notes.map((note) => (
						<a
							href={withBase(`notes/${note.id}/`)}
							class="note-card block rounded-2xl p-5 pl-6"
						>
							<p class="text-sm text-zinc-500">
								{getNoteDisplayDateLabel(note)}{" "}
								{getNoteDisplayDate(note).toLocaleDateString("zh-TW")}
							</p>
							<h2 class="mt-2 text-xl font-semibold text-zinc-950 dark:text-zinc-50">
								{note.data.title}
							</h2>
							<p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
								{note.data.description}
							</p>
						</a>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
