---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import {
	getNoteCategories,
	getNoteDisplayDate,
	getNoteDisplayDateLabel,
	sortNotesByDate,
} from "../../lib/notes";

const notes = sortNotesByDate(await getCollection("notes"));
const categories = getNoteCategories(notes);
---

<BaseLayout title="筆記 | Hsiun Blog">
	<section class="mx-auto min-h-screen max-w-5xl px-5 py-20 sm:py-24">
		<div class="mx-auto max-w-4xl">
			<div class="surface-card rounded-3xl p-6 sm:p-8">
				<p class="eyebrow">Notes</p>
				<h1 class="mt-4 text-4xl font-black tracking-tight text-zinc-950 dark:text-zinc-50 sm:text-5xl">筆記</h1>
				<p class="mt-4 max-w-2xl text-base leading-7 text-zinc-600 dark:text-zinc-300">
					依照主題整理前端學習筆記，快速回到當時理解一個觀念的脈絡。
				</p>
			</div>

			<nav class="mt-8 flex flex-wrap gap-2" aria-label="筆記分類">
				<a
					href="/notes"
					class="pill-active rounded-full px-4 py-2 text-sm font-semibold"
				>
					All Notes
				</a>
				{
					categories.map((category) => (
						<a
							href={`/notes/category/${category.slug}/`}
							class="pill-link rounded-full px-4 py-2 text-sm font-medium transition"
						>
							{category.name}
						</a>
					))
				}
			</nav>

			<div class="mt-10 space-y-4">
				{
					notes.map((note) => (
						<a
							href={`/notes/${note.id}/`}
							class="note-card block rounded-2xl p-5 pl-6 transition hover:-translate-y-0.5 hover:shadow-xl hover:shadow-zinc-950/10 dark:hover:shadow-black/25"
						>
							<div class="flex flex-wrap items-center gap-2 text-sm text-zinc-500">
								<span>
									{getNoteDisplayDateLabel(note)}{" "}
									{getNoteDisplayDate(note).toLocaleDateString("zh-TW")}
								</span>
								<span>·</span>
								<span>{note.data.category}</span>
							</div>
							<h2 class="mt-2 text-xl font-semibold text-zinc-950 dark:text-zinc-50">
								{note.data.title}
							</h2>
							<p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
								{note.data.description}
							</p>
						</a>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
