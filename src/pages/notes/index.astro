---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import {
	getNoteCategories,
	getNoteDisplayDate,
	getNoteDisplayDateLabel,
	sortNotesByDate,
} from "../../lib/notes";

const notes = sortNotesByDate(await getCollection("notes"));
const categories = getNoteCategories(notes);
---

<BaseLayout title="筆記 | Hsiun Blog">
	<section class="mx-auto min-h-screen max-w-4xl px-5 py-20">
		<div class="mx-auto max-w-4xl">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-zinc-500">
				Notes
			</p>
			<h1 class="mt-4 text-4xl font-bold tracking-tight text-zinc-950">筆記</h1>

			<nav class="mt-8 flex flex-wrap gap-2" aria-label="筆記分類">
				<a
					href="/notes"
					class="rounded-full bg-zinc-950 px-4 py-2 text-sm font-medium text-white"
				>
					All Notes
				</a>
				{
					categories.map((category) => (
						<a
							href={`/notes/category/${category.slug}/`}
							class="rounded-full border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-950"
						>
							{category.name}
						</a>
					))
				}
			</nav>

			<div class="mt-10 space-y-4">
				{
					notes.map((note) => (
						<a
							href={`/notes/${note.id}/`}
							class="block rounded-xl border border-zinc-200 bg-white p-5 transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-zinc-950/10"
						>
							<div class="flex flex-wrap items-center gap-2 text-sm text-zinc-500">
								<span>
									{getNoteDisplayDateLabel(note)}{" "}
									{getNoteDisplayDate(note).toLocaleDateString("zh-TW")}
								</span>
								<span>·</span>
								<span>{note.data.category}</span>
							</div>
							<h2 class="mt-2 text-xl font-semibold text-zinc-950">
								{note.data.title}
							</h2>
							<p class="mt-2 text-sm leading-6 text-zinc-600">
								{note.data.description}
							</p>
						</a>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
