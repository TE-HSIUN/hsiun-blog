---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import {
	getNoteDisplayDate,
	getNoteDisplayDateLabel,
	sortNotesByDate,
} from "../lib/notes";

const notes = sortNotesByDate(await getCollection("notes"));
const recentNotes = notes.slice(0, 3);
const currentTopics = [
	{ name: "JavaScript", href: "/notes/category/javascript/" },
];
const noteCount = notes.length;
const topicCount = currentTopics.length;
---

<BaseLayout title="Hsiun Blog">
	<section class="mx-auto min-h-screen max-w-5xl px-5 py-20 sm:py-24">
		<div class="surface-card rounded-3xl p-6 sm:p-10">
			<div class="grid gap-10 lg:grid-cols-[1.25fr_0.75fr] lg:items-end">
				<div>
					<p class="eyebrow">My Notes</p>
					<h1 class="mt-4 max-w-3xl text-5xl font-black tracking-tight text-zinc-950 dark:text-zinc-50 sm:text-6xl">
						Hsiun Blog
					</h1>
					<p class="mt-6 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-300">
						把前端學習過程中的觀念、踩坑與整理，寫成可以反覆回來翻看的筆記。
					</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a
							href="/notes"
							class="inline-flex rounded-xl bg-zinc-950 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-zinc-950/15 transition hover:-translate-y-0.5 hover:bg-zinc-800 dark:bg-zinc-50 dark:text-zinc-950 dark:hover:bg-zinc-200"
						>
							查看筆記
						</a>
						<a
							href="#recent"
							class="inline-flex rounded-xl border border-zinc-200 bg-white/70 px-5 py-3 text-sm font-semibold text-zinc-700 backdrop-blur transition hover:-translate-y-0.5 hover:border-zinc-300 hover:text-zinc-950 dark:border-zinc-700 dark:bg-zinc-900/70 dark:text-zinc-300 dark:hover:text-zinc-50"
						>
							最近更新
						</a>
					</div>
				</div>

				<div class="grid grid-cols-2 gap-3">
					<div class="rounded-2xl border border-zinc-200/80 bg-white/70 p-5 dark:border-zinc-700/80 dark:bg-zinc-900/60">
						<p class="text-3xl font-black tracking-tight text-zinc-950 dark:text-zinc-50">{noteCount}</p>
						<p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">篇筆記</p>
					</div>
					<div class="rounded-2xl border border-zinc-200/80 bg-white/70 p-5 dark:border-zinc-700/80 dark:bg-zinc-900/60">
						<p class="text-3xl font-black tracking-tight text-zinc-950 dark:text-zinc-50">{topicCount}</p>
						<p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">個主題</p>
					</div>
					<div class="col-span-2 rounded-2xl bg-zinc-950 p-5 text-white shadow-xl shadow-zinc-950/15 dark:bg-zinc-50 dark:text-zinc-950 dark:shadow-black/25">
						<p class="text-sm font-semibold uppercase tracking-[0.18em] opacity-70">Focus</p>
						<p class="mt-3 text-xl font-bold">JavaScript / HTML / CSS</p>
					</div>
				</div>
			</div>
		</div>

		<div id="recent" class="mt-16">
			<div class="flex items-end justify-between gap-4">
				<div>
					<p class="eyebrow">Recent</p>
					<h2 class="mt-3 text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
						最近更新
					</h2>
				</div>
				<a
					href="/notes"
					class="hidden text-sm font-medium text-zinc-600 transition hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-zinc-50 sm:inline"
				>
					全部筆記
				</a>
			</div>

			<div class="mt-6 space-y-4">
				{
					recentNotes.length > 0 ? (
						recentNotes.map((note) => (
							<a
								href={`/notes/${note.id}/`}
								class="note-card block rounded-2xl p-5 pl-6 transition hover:-translate-y-0.5 hover:shadow-xl hover:shadow-zinc-950/10 dark:hover:shadow-black/25"
							>
								<div class="flex flex-wrap items-center gap-2 text-sm text-zinc-500">
									<span>
										{getNoteDisplayDateLabel(note)}{" "}
										{getNoteDisplayDate(note).toLocaleDateString("zh-TW")}
									</span>
									<span>·</span>
									<span>{note.data.category}</span>
								</div>
								<h3 class="mt-2 text-xl font-semibold text-zinc-950 dark:text-zinc-50">
									{note.data.title}
								</h3>
								<p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
									{note.data.description}
								</p>
							</a>
						))
					) : (
						<p class="surface-card rounded-2xl p-5 text-sm text-zinc-500 dark:text-zinc-400">
							目前還沒有筆記。
						</p>
					)
				}
			</div>
		</div>

		<div class="mt-16">
			<p class="eyebrow">Topics</p>
			<h2 class="mt-3 text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
				目前整理中
			</h2>
			<div class="mt-6 flex flex-wrap gap-2">
				{
					currentTopics.map((topic) => (
						<a
							href={topic.href}
							class="pill-link rounded-full px-4 py-2 text-sm font-medium transition"
						>
							{topic.name}
						</a>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
