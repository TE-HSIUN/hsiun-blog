---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import {
	getNoteDisplayDate,
	getNoteDisplayDateLabel,
	sortNotesByDate,
} from "../lib/notes";

const notes = sortNotesByDate(await getCollection("notes"));
const recentNotes = notes.slice(0, 3);
const currentTopics = [
	{ name: "JavaScript", href: "/notes/category/javascript/" },
];
---

<BaseLayout title="Hsiun Blog">
	<section class="mx-auto min-h-screen max-w-4xl px-5 py-20">
		<div class="max-w-3xl">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-zinc-500">
				My Notes
			</p>
			<h1 class="mt-4 text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50 sm:text-5xl">
				Hsiun Blog
			</h1>
			<p class="mt-5 max-w-2xl text-lg leading-8 text-zinc-600 dark:text-zinc-400">
				我的前端學習筆記。把學到的 JavaScript、HTML、CSS或網頁前端開發觀念整理成可以反覆回看的文章。
			</p>
			<a
				href="/notes"
				class="mt-8 inline-flex rounded-lg bg-zinc-950 px-5 py-3 text-sm font-medium text-white transition hover:-translate-y-0.5 hover:bg-zinc-800 hover:shadow-lg hover:shadow-zinc-950/10 dark:bg-zinc-50 dark:text-zinc-950 dark:hover:bg-zinc-200"
			>
				查看筆記
			</a>
		</div>

		<div class="mt-16">
			<div class="flex items-end justify-between gap-4">
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.2em] text-zinc-500">
						Recent
					</p>
					<h2 class="mt-3 text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
						最近更新
					</h2>
				</div>
				<a
					href="/notes"
					class="hidden text-sm font-medium text-zinc-600 transition hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-zinc-50 sm:inline"
				>
					全部筆記
				</a>
			</div>

			<div class="mt-6 space-y-4">
				{
					recentNotes.length > 0 ? (
						recentNotes.map((note) => (
							<a
								href={`/notes/${note.id}/`}
								class="block rounded-xl border border-zinc-200 bg-white p-5 transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-zinc-950/10 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:shadow-black/20"
							>
								<div class="flex flex-wrap items-center gap-2 text-sm text-zinc-500">
									<span>
										{getNoteDisplayDateLabel(note)}{" "}
										{getNoteDisplayDate(note).toLocaleDateString("zh-TW")}
									</span>
									<span>·</span>
									<span>{note.data.category}</span>
								</div>
								<h3 class="mt-2 text-xl font-semibold text-zinc-950 dark:text-zinc-50">
									{note.data.title}
								</h3>
								<p class="mt-2 text-sm leading-6 text-zinc-600 dark:text-zinc-400">
									{note.data.description}
								</p>
							</a>
						))
					) : (
						<p class="rounded-xl border border-zinc-200 bg-white p-5 text-sm text-zinc-500 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400">
							目前還沒有筆記。
						</p>
					)
				}
			</div>
		</div>

		<div class="mt-16">
			<p class="text-sm font-semibold uppercase tracking-[0.2em] text-zinc-500">
				Topics
			</p>
			<h2 class="mt-3 text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
				目前整理中
			</h2>
			<div class="mt-6 flex flex-wrap gap-2">
				{
					currentTopics.map((topic) => (
						<a
							href={topic.href}
							class="rounded-full border border-zinc-200 bg-white px-4 py-2 text-sm font-medium text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-950 dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-50"
						>
							{topic.name}
						</a>
					))
				}
			</div>
		</div>
	</section>
</BaseLayout>
