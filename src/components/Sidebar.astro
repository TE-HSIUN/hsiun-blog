---
const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isNotes = pathname.startsWith("/notes");

const activeLinkClass = "block rounded-lg bg-zinc-950 px-4 py-3 text-sm font-medium text-white";
const inactiveLinkClass =
	"block rounded-lg px-4 py-3 text-sm font-medium text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-950";
---

<button
	id="openSidebar"
	type="button"
	class="fixed left-4 top-4 z-[60] flex size-10 flex-col items-center justify-center gap-1.5 rounded-xl border border-zinc-200 bg-white shadow-sm shadow-zinc-950/10 transition-[left,top,transform,opacity,box-shadow,background-color,border-color] duration-300 ease-out hover:-translate-y-0.5 hover:bg-zinc-100 hover:shadow-md"
	aria-label="開啟側邊欄"
	aria-controls="sidebar"
	aria-expanded="false"
>
	<span class="h-px w-5 rounded-full bg-zinc-900"></span>
	<span class="h-px w-5 rounded-full bg-zinc-900"></span>
	<span class="h-px w-5 rounded-full bg-zinc-900"></span>
</button>

<aside
	id="sidebar"
	class="fixed bottom-2 left-3 top-16 z-50 w-60 -translate-x-[calc(100%+1rem)] rounded-2xl border border-zinc-200 bg-white/95 px-4 py-4 shadow-2xl shadow-zinc-950/15 backdrop-blur transition-all duration-300 ease-out"
	aria-label="側邊欄"
>
	<div class="flex items-center justify-between">
		<p class="text-lg font-semibold tracking-tight">Hsiun Blog</p>
	</div>

	<nav class="mt-8 space-y-2" aria-label="側邊導覽">
		<a href="/" class={isHome ? activeLinkClass : inactiveLinkClass}>首頁</a>
		<a href="/notes" class={isNotes ? activeLinkClass : inactiveLinkClass}>筆記</a>
	</nav>
</aside>

<div
	id="sidebarOverlay"
	class="fixed inset-0 z-40 hidden bg-zinc-950/30 sm:hidden"
	aria-hidden="true"
>
</div>
