---
const pathname = Astro.url.pathname;
const isHome = pathname === "/";
const isNotes = pathname.startsWith("/notes");

const activeLinkClass =
	"block rounded-lg bg-zinc-950 px-4 py-3 text-sm font-medium text-white shadow-lg shadow-zinc-950/15 dark:bg-zinc-50 dark:text-zinc-950 dark:shadow-black/25";
const inactiveLinkClass =
	"block rounded-lg px-4 py-3 text-sm font-medium text-zinc-600 transition hover:bg-zinc-100/80 hover:text-zinc-950 dark:text-zinc-400 dark:hover:bg-zinc-800/80 dark:hover:text-zinc-50";
---

<button
	id="openSidebar"
	type="button"
	class="fixed left-4 top-4 z-[60] flex size-10 flex-col items-center justify-center gap-1.5 rounded-xl border border-zinc-200 bg-white shadow-sm shadow-zinc-950/10 transition-[left,top,transform,opacity,box-shadow,background-color,border-color] duration-300 ease-out hover:-translate-y-0.5 hover:bg-zinc-100 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-900 dark:shadow-black/20 dark:hover:bg-zinc-800"
	aria-label="開啟側邊欄"
	aria-controls="sidebar"
	aria-expanded="false"
>
	<span class="h-px w-5 rounded-full bg-zinc-900 dark:bg-zinc-100"></span>
	<span class="h-px w-5 rounded-full bg-zinc-900 dark:bg-zinc-100"></span>
	<span class="h-px w-5 rounded-full bg-zinc-900 dark:bg-zinc-100"></span>
</button>

<aside
	id="sidebar"
	class="fixed bottom-2 left-3 top-16 z-50 w-60 -translate-x-[calc(100%+1rem)] rounded-2xl border border-zinc-200 bg-white/95 px-4 py-4 shadow-2xl shadow-zinc-950/15 backdrop-blur transition-all duration-300 ease-out dark:border-zinc-800 dark:bg-zinc-900/95 dark:shadow-black/30"
	aria-label="側邊欄"
>
	<div class="flex items-center justify-between">
		<a href="/" class="group flex items-center gap-3">
			<span class="grid size-9 place-items-center rounded-xl bg-zinc-950 text-sm font-bold text-white shadow-lg shadow-zinc-950/15 dark:bg-zinc-50 dark:text-zinc-950 dark:shadow-black/25">
				H
			</span>
			<span>
				<span class="block text-base font-semibold tracking-tight text-zinc-950 dark:text-zinc-50">Hsiun Blog</span>
				<span class="block text-xs text-zinc-500 dark:text-zinc-400">Frontend notes</span>
			</span>
		</a>
	</div>

	<nav class="mt-8 space-y-2" aria-label="側邊導覽">
		<a href="/" class={isHome ? activeLinkClass : inactiveLinkClass}>首頁</a>
		<a href="/notes" class={isNotes ? activeLinkClass : inactiveLinkClass}>筆記</a>
	</nav>
</aside>

<div
	id="sidebarOverlay"
	class="fixed inset-0 z-40 hidden bg-zinc-950/30 sm:hidden dark:bg-black/50"
	aria-hidden="true"
>
</div>
